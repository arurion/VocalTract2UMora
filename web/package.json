{
  "name": "vocaltract2umora-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --release --out-dir ../../web/src/wasm-pkg --out-name vt2umora_wasm",
    "wasm:dev": "wasm-pack build ../crates/wasm --target web --dev --out-dir ../../web/src/wasm-pkg --out-name vt2umora_wasm",
    "dev": "npm run wasm:dev && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
